{
  "name": "ariadneos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:dependencies": "npm audit --audit-level=high",
    "build": "tsc --noEmit && vite build",
    "check": "npm run lint && npm run typecheck && npm run fixtures:validate && npm run test:coverage && npm run test:guardrails && npm run test:migration && npm run build",
    "check:repo": "python3 scripts/check_quality.py",
    "db:local": "wrangler d1 migrations apply ariadneos-demo --local",
    "db:production": "wrangler d1 migrations apply DB --env production --remote",
    "db:remote": "wrangler d1 migrations apply ariadneos-demo --remote",
    "db:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "deploy": "npm run build && wrangler deploy",
    "deploy:production": "npm run build && wrangler deploy --env production",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "dev": "npm run build && wrangler dev",
    "dev:ui": "vite --host 0.0.0.0",
    "fix": "ultracite fix",
    "fixtures:validate": "tsx scripts/validate-fixtures.ts",
    "format": "biome format --write .",
    "lint": "biome ci --error-on-warnings .",
    "prepare": "husky",
    "seed:generate": "tsx scripts/seed.ts",
    "sim:generate": "tsx scripts/generate-demo-transcripts.ts --all",
    "sim:readiness": "tsx scripts/check-demo-readiness.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:deployment": "node scripts/check-deployment.mjs",
    "test:e2e": "python3 scripts/check_smoke.py --browser",
    "test:guardrails": "python3 scripts/check_guardrails.py",
    "test:integration": "python3 scripts/check_smoke.py",
    "test:migration": "node scripts/check-pm-migration.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@mastra/core": "1.66.0",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@xyflow/react": "^12.11.6",
    "ai": "7.0.99",
    "better-auth": "1.7.4",
    "hono": "^4.13.7",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "husky": "9.1.7",
    "jsonc-parser": "3.3.1",
    "lint-staged": "17.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "ultracite": "7.11.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
