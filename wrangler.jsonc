{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ariadneos-demo",
  "main": "server/index.ts",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "dev": { "host": "localhost" },
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "ariadneos.com",
      "custom_domain": true
    },
    {
      "pattern": "www.ariadneos.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ariadneos-demo",
      "database_id": "ac5322ab-e51d-4d27-b4dc-5c69b6a8e979",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHANNEL_COORDINATOR",
        "class_name": "ChannelCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1_channel_coordinator",
      "new_sqlite_classes": ["ChannelCoordinator"]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "vars": {
    "AGENT_DAILY_OPENROUTER_LIMIT": "5",
    "AGENT_ENABLED": "false",
    "AGENT_TIMEOUT_MS": "12000",
    "APP_ENV": "production",
    "BETTER_AUTH_URL": "https://ariadneos.com",
    "MODEL_ANSWER": "anthropic/claude-sonnet-4",
    "MODEL_ANSWER_MAX_TOKENS": "96",
    "MODEL_CLASSIFY": "openai/gpt-4.1-mini",
    "MODEL_CLASSIFY_MAX_TOKENS": "128",
    "MODEL_EXTRACT": "openai/gpt-4.1-mini",
    "MODEL_EXTRACT_MAX_TOKENS": "256",
    "OPENROUTER_APP_TITLE": "AriadneOS",
    "OPENROUTER_SITE_URL": "https://ariadneos.com",
    "RELEASE_SHA": "local",
    "SLACK_ALLOWED_TEAM_ID": "",
    "SLACK_ALLOWED_CHANNEL_ID": ""
  },
  "env": {
    "staging": {
      "name": "ariadneos-staging",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "staging.ariadneos.com",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ariadneos-staging",
          "database_id": "157ed4f8-e4bd-4ce4-9282-a1e0702ba08b",
          "migrations_dir": "migrations"
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "CHANNEL_COORDINATOR",
            "class_name": "ChannelCoordinator"
          }
        ]
      },
      "vars": {
        "AGENT_DAILY_OPENROUTER_LIMIT": "5",
        "AGENT_ENABLED": "true",
        "AGENT_TIMEOUT_MS": "12000",
        "APP_ENV": "staging",
        "BETTER_AUTH_URL": "https://staging.ariadneos.com",
        "MODEL_ANSWER": "anthropic/claude-sonnet-4",
        "MODEL_ANSWER_MAX_TOKENS": "96",
        "MODEL_CLASSIFY": "openai/gpt-4.1-mini",
        "MODEL_CLASSIFY_MAX_TOKENS": "128",
        "MODEL_EXTRACT": "openai/gpt-4.1-mini",
        "MODEL_EXTRACT_MAX_TOKENS": "256",
        "OPENROUTER_APP_TITLE": "AriadneOS Staging",
        "OPENROUTER_SITE_URL": "https://staging.ariadneos.com",
        "RELEASE_SHA": "local",
        "SLACK_ALLOWED_TEAM_ID": "",
        "SLACK_ALLOWED_CHANNEL_ID": ""
      },
      "triggers": {
        "crons": ["27 3 * * *"]
      }
    },
    "production": {
      "name": "ariadneos-demo",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "ariadneos.com",
          "custom_domain": true
        },
        {
          "pattern": "www.ariadneos.com",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ariadneos-demo",
          "database_id": "ac5322ab-e51d-4d27-b4dc-5c69b6a8e979",
          "migrations_dir": "migrations"
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "CHANNEL_COORDINATOR",
            "class_name": "ChannelCoordinator"
          }
        ]
      },
      "vars": {
        "AGENT_DAILY_OPENROUTER_LIMIT": "5",
        "AGENT_ENABLED": "false",
        "AGENT_TIMEOUT_MS": "12000",
        "APP_ENV": "production",
        "BETTER_AUTH_URL": "https://ariadneos.com",
        "MODEL_ANSWER": "anthropic/claude-sonnet-4",
        "MODEL_ANSWER_MAX_TOKENS": "96",
        "MODEL_CLASSIFY": "openai/gpt-4.1-mini",
        "MODEL_CLASSIFY_MAX_TOKENS": "128",
        "MODEL_EXTRACT": "openai/gpt-4.1-mini",
        "MODEL_EXTRACT_MAX_TOKENS": "256",
        "OPENROUTER_APP_TITLE": "AriadneOS",
        "OPENROUTER_SITE_URL": "https://ariadneos.com",
        "RELEASE_SHA": "local",
        "SLACK_ALLOWED_TEAM_ID": "",
        "SLACK_ALLOWED_CHANNEL_ID": ""
      },
      "triggers": {
        "crons": ["17 3 * * *"]
      }
    }
  }
}
